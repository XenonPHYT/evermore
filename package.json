{
  "name": "evermore",
  "version": "1.0.0",
  "description": "Local-first creative greetings and notes for Cloudflare Workers",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:integration": "playwright test --project=integration",
    "test:e2e": "playwright test",
    "deploy": "npm run build && npm run deploy:built",
    "deploy:built": "wrangler deploy --keep-vars",
    "test:serve": "node scripts/test-server.mjs",
    "db:init:local": "wrangler d1 execute DB --local --file=database/schema.sql",
    "db:init:remote": "wrangler d1 execute DB --remote --config wrangler.jsonc --file=database/schema.sql"
  },
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "private": true,
  "dependencies": {
    "hono": "^4.13.19",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/workers-types": "^5.20261120.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.3.8",
    "vitest": "^3.2.7",
    "wrangler": "^4.166.0"
  }
}
